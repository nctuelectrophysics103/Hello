{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Pad Pin Mapper",
            "type": "shell",
            "command": "python3",
            "args": ["pad_pin_mapper.py"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Install Python Dependencies",
            "type": "shell",
            "command": "pip3",
            "args": ["install", "-r", "requirements.txt"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new"
            }
        },
        {
            "label": "Python: Format Code",
            "type": "shell",
            "command": "black",
            "args": ["--line-length=88", "*.py"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false
            }
        },
        {
            "label": "Python: Lint Code",
            "type": "shell",
            "command": "pylint",
            "args": ["*.py"],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false
            }
        },
        {
            "label": "Run Demo",
            "type": "shell",
            "command": "python3",
            "args": ["demo_usage.py"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Test Core Functionality",
            "type": "shell",
            "command": "python3",
            "args": ["test_core_functionality.py"],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new"
            },
            "problemMatcher": []
        }
    ]
}